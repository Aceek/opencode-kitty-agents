{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-kitty-agents",
  "version": "0.1.0",
  "description": "OpenCode plugin that presents child agent sessions in managed Kitty splits.",
  "type": "module",
  "license": "MIT",
  "author": "Aceek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aceek/opencode-kitty-agents.git"
  },
  "bugs": {
    "url": "https://github.com/Aceek/opencode-kitty-agents/issues"
  },
  "homepage": "https://github.com/Aceek/opencode-kitty-agents#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "opencode-kitty-agents-broker": "./dist/broker/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.gate0.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "gate0:result": "bun test/gate0/read-result.ts"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.4"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.4",
    "@types/bun": "1.3.13",
    "typescript": "5.8.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "kitty",
    "subagent",
    "terminal"
  ]
}
